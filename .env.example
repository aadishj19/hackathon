# Copy to .env and fill in ONE LLM provider. With no key at all the app runs in mock mode.
# After editing .env, click "Reload data" in the app; no restart needed.
#
# LLM_PROVIDER: auto | anthropic | vertex | gemini | openai | azure | mock
# "auto" picks the first of anthropic, azure, openai, gemini that has a key set.
# vertex and Gemini-through-Google-Cloud have no key, so set LLM_PROVIDER explicitly.
LLM_PROVIDER=auto

# Anthropic (Claude). ANTHROPIC_MODEL and ANTHROPIC_EFFORT also apply to vertex.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high. Lower = faster answers during a live demo.
ANTHROPIC_EFFORT=medium

# Google Cloud (event tech partner). Used by LLM_PROVIDER=vertex (Claude on Google Cloud)
# and by LLM_PROVIDER=gemini when GEMINI_API_KEY is empty. Log in once with:
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Gemini. Either an AI Studio key (https://aistudio.google.com/apikey) or leave it empty
# and use the Google Cloud project above. Check current model names at
# https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used when the main model stays overloaded after retries (it happens at peak times).
# Leave empty to disable.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# Azure OpenAI (in case KBC provides an endpoint). AZURE_OPENAI_DEPLOYMENT is the
# deployment name from the Azure portal, not the model name.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# ElevenLabs (event tech partner): voice questions and read-aloud answers in the Chat tab.
# Optional; voice features stay hidden without a key. The defaults speak Dutch and French too.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2

# Folder the app loads tables from. Point it at data/raw once the challenge data arrives.
DATA_DIR=data/sample

# How much of the data the LLM sees (in Ask your data and Chat):
#   schema  = table and column names, types, row counts
#   labels  = schema plus the values of low-variety text columns (category = travel, ...)
#   samples = labels plus 3 real rows per table; only for synthetic or approved data
# No data rows leave the laptop unless this is "samples".
LLM_DATA_DETAIL=labels
